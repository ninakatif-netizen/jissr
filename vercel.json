{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/(family|verify)(.html)?",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/patient.html",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/staff.html",
      "destination": "/team.html",
      "permanent": false
    },
    {
      "source": "/care.html",
      "destination": "/team.html",
      "permanent": false
    },
    {
      "source": "/roles.html",
      "destination": "/team.html",
      "permanent": false
    },
    {
      "source": "/metrics.html",
      "destination": "/team.html",
      "permanent": false
    },
    {
      "source": "/map.html",
      "destination": "/team.html",
      "permanent": false
    },
    {
      "source": "/pathways.html",
      "destination": "/team.html",
      "permanent": false
    },
    {
      "source": "/impact.html",
      "destination": "/jury.html",
      "permanent": false
    },
    {
      "source": "/pilot.html",
      "destination": "/jury.html",
      "permanent": false
    },
    {
      "source": "/review.html",
      "destination": "/jury.html",
      "permanent": false
    },
    {
      "source": "/trust.html",
      "destination": "/jury.html",
      "permanent": false
    },
    {
      "source": "/animation/(.*)",
      "destination": "/loop.html",
      "permanent": false
    }
  ]
}
